rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedSignedIn() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerAndVerified(userId) {
      return verifiedSignedIn()
        && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function recentlyAuthenticated() {
      return signedIn()
        && request.auth.token.auth_time is int
        && request.time.toMillis() - request.auth.token.auth_time * 1000
          <= 5 * 60 * 1000;
    }

    function deletionRequested(userId) {
      return exists(/databases/$(database)/documents/deleted_accounts/$(userId));
    }

    function canDeleteOwnAccountData(userId) {
      return isOwner(userId) && deletionRequested(userId);
    }

    function isShareCode(shareCode) {
      return shareCode.matches('^[A-Z0-9]{5,32}$');
    }

    function isInstallationId(deviceId) {
      return deviceId.matches('^[A-Za-z0-9_-]{16,96}$');
    }

    function isActivePublicShare(data) {
      return data.isActive == true
        && data.expiresAt is timestamp
        && data.expiresAt > request.time;
    }

    function sharedScheduleExists(shareCode) {
      return exists(/databases/$(database)/documents/shared_schedules/$(shareCode));
    }

    function ownsShare(data) {
      return verifiedSignedIn() && data.ownerId == request.auth.uid;
    }

    function canDeleteOwnedShare(data) {
      return signedIn()
        && data.ownerId == request.auth.uid
        && deletionRequested(request.auth.uid);
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function stringWithMax(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalStringWithMax(data, field, max) {
      return !hasField(data, field) || stringWithMax(data[field], max);
    }

    function intInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function listWithMax(value, max) {
      return value is list && value.size() <= max;
    }

    function optionalListWithMax(data, field, max) {
      return !hasField(data, field) || listWithMax(data[field], max);
    }

    function optionalNullableStringWithMax(data, field, max) {
      return !hasField(data, field)
        || data[field] == null
        || stringWithMax(data[field], max);
    }

    function optionalTimestamp(data, field) {
      return !hasField(data, field) || data[field] is timestamp;
    }

    function validDeviceDocument(data) {
      return data.keys().hasAll(["status"])
        && data.keys().hasOnly([
          "status",
          "name",
          "platform",
          "brand",
          "model",
          "createdAt",
          "lastLogin",
          "lastSeenAt",
          "lastIpAddress",
          "lastIpUpdatedAt",
          "lastLoginNotificationAt",
          "lastSyncTime",
          "expoPushToken",
          "pushPermissionStatus",
          "pushTokenPlatform",
          "pushTokenUpdatedAt",
          "pushTokenError",
          "revokedAt",
          "revokedReason"
        ])
        && data.status in ["active", "revoked", "expired"]
        && optionalNullableStringWithMax(data, "name", 512)
        && optionalNullableStringWithMax(data, "platform", 40)
        && optionalNullableStringWithMax(data, "brand", 80)
        && optionalNullableStringWithMax(data, "model", 120)
        && optionalNullableStringWithMax(data, "lastIpAddress", 64)
        && optionalNullableStringWithMax(data, "expoPushToken", 256)
        && optionalNullableStringWithMax(data, "pushPermissionStatus", 80)
        && optionalNullableStringWithMax(data, "pushTokenPlatform", 40)
        && optionalNullableStringWithMax(data, "pushTokenError", 160)
        && optionalNullableStringWithMax(data, "revokedReason", 40)
        && optionalTimestamp(data, "createdAt")
        && optionalTimestamp(data, "lastLogin")
        && optionalTimestamp(data, "lastSeenAt")
        && optionalTimestamp(data, "lastIpUpdatedAt")
        && optionalTimestamp(data, "lastLoginNotificationAt")
        && optionalTimestamp(data, "lastSyncTime")
        && optionalTimestamp(data, "pushTokenUpdatedAt")
        && optionalTimestamp(data, "revokedAt")
        && (
          (
            data.status == "active"
            && data.keys().hasAll([
              "name",
              "platform",
              "brand",
              "model",
              "createdAt",
              "lastLogin",
              "lastSeenAt"
            ])
            && !hasField(data, "revokedAt")
            && !hasField(data, "revokedReason")
          )
          || (
            data.status in ["revoked", "expired"]
            && data.keys().hasAll(["revokedAt", "revokedReason"])
          )
        );
    }

    function validNotificationMetadata(data) {
      return data is map
        && data.keys().hasOnly(["brand", "model"])
        && optionalNullableStringWithMax(data, "brand", 80)
        && optionalNullableStringWithMax(data, "model", 120);
    }

    function validNotificationDocument(data) {
      return data.keys().hasAll([
          "type",
          "title",
          "message",
          "createdAt",
          "expiresAt",
          "readAt",
          "deviceId",
          "deviceName",
          "platform",
          "ipAddress",
          "metadata"
        ])
        && data.keys().hasOnly([
          "type",
          "title",
          "message",
          "createdAt",
          "expiresAt",
          "readAt",
          "deviceId",
          "deviceName",
          "platform",
          "ipAddress",
          "metadata"
        ])
        && data.type == "account_login"
        && stringWithMax(data.title, 160)
        && stringWithMax(data.message, 500)
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && (data.readAt == null || data.readAt is timestamp)
        && optionalNullableStringWithMax(data, "deviceId", 96)
        && (data.deviceId == null || isInstallationId(data.deviceId))
        && stringWithMax(data.deviceName, 512)
        && stringWithMax(data.platform, 40)
        && stringWithMax(data.ipAddress, 64)
        && validNotificationMetadata(data.metadata);
    }

    function validReminder(value) {
      return value is map
        && value.keys().hasOnly(["enabled", "minutesBefore"])
        && value.keys().hasAll(["enabled"])
        && value.enabled is bool
        && (
          (value.enabled == false && !value.keys().hasAny(["minutesBefore"]))
          || (value.enabled == true && intInRange(value.minutesBefore, 0, 1440))
        );
    }

    function optionalReminder(data, field) {
      return !hasField(data, field) || validReminder(data[field]);
    }

    function validScheduleData(data) {
      return data.keys().hasAll(["name", "repeat", "duration", "start_time", "subjects", "schedule"])
        && data.keys().hasOnly([
          "name",
          "repeat",
          "duration",
          "breaks",
          "start_time",
          "starting_week",
          "reminder",
          "subjects",
          "teachers",
          "links",
          "gradients",
          "tasks",
          "schedule",
          "color"
        ])
        && stringWithMax(data.name, 80)
        && intInRange(data.repeat, 1, 12)
        && intInRange(data.duration, 1, 600)
        && stringWithMax(data.start_time, 5)
        && optionalStringWithMax(data, "starting_week", 40)
        && optionalStringWithMax(data, "color", 32)
        && optionalReminder(data, "reminder")
        && optionalListWithMax(data, "breaks", 40)
        && listWithMax(data.subjects, 250)
        && optionalListWithMax(data, "teachers", 250)
        && optionalListWithMax(data, "links", 250)
        && optionalListWithMax(data, "gradients", 100)
        && optionalListWithMax(data, "tasks", 500)
        && listWithMax(data.schedule, 7);
    }

    function validVersionFields(data) {
      return data.version is int
        && data.version >= 1;
    }

    function validScheduleDocument(data) {
      return data.keys().hasAll(["version", "lastModified"])
        && validVersionFields(data)
        && data.lastModified is number
        && !hasField(data, "_c")
        && !hasField(data, "_p")
        && !hasField(data, "id")
        && !hasField(data, "baseVersion")
        && !hasField(data, "lastSynced")
        && optionalStringWithMax(data, "name", 120)
        && optionalListWithMax(data, "subjects", 500)
        && optionalListWithMax(data, "teachers", 500)
        && optionalListWithMax(data, "links", 500)
        && optionalListWithMax(data, "gradients", 250)
        && optionalListWithMax(data, "tasks", 2000)
        && optionalListWithMax(data, "schedule", 14)
        && (!hasField(data, "isDeleted") || data.isDeleted is bool)
        && (!hasField(data, "deletedAt") || data.deletedAt is number);
    }

    function validGlobalDocument(data) {
      return data.keys().hasAll(["version", "lastModified"])
        && validVersionFields(data)
        && data.lastModified is number
        && !hasField(data, "_c")
        && !hasField(data, "_p")
        && !hasField(data, "baseVersion")
        && !hasField(data, "lastSynced")
        && (!hasField(data, "watermark") || data.watermark is number)
        && (!hasField(data, "watermarkUpdatedAt") || data.watermarkUpdatedAt is number);
    }

    function isMonotonicVersionUpdate() {
      return resource.data.version is int
        && request.resource.data.version == resource.data.version + 1;
    }

    function validSharedScheduleBase(data, shareCode) {
      return data.keys().hasAll([
          "id",
          "ownerId",
          "ownerName",
          "scheduleName",
          "createdAt",
          "expiresAt",
          "isActive"
        ])
        && data.id == shareCode
        && stringWithMax(data.ownerId, 128)
        && stringWithMax(data.ownerName, 120)
        && stringWithMax(data.scheduleName, 120)
        && data.createdAt is number
        && data.expiresAt is timestamp
        && data.isActive is bool;
    }

    function validSharedScheduleDoc(data, shareCode) {
      return validSharedScheduleBase(data, shareCode)
        && data.keys().hasAll(["scheduleData"])
        && data.keys().hasOnly([
          "id",
          "ownerId",
          "ownerName",
          "scheduleName",
          "scheduleData",
          "createdAt",
          "expiresAt",
          "isActive"
        ])
        && data.scheduleData is map
        && validScheduleData(data.scheduleData);
    }

    function validSharedScheduleCreate(shareCode) {
      return isShareCode(shareCode)
        && verifiedSignedIn()
        && !deletionRequested(request.auth.uid)
        && validSharedScheduleDoc(request.resource.data, shareCode)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, "d");
    }

    function validSharedScheduleUpdate(shareCode) {
      return isShareCode(shareCode)
        && ownsShare(resource.data)
        && validSharedScheduleDoc(request.resource.data, shareCode)
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.isActive == false || request.resource.data.expiresAt > request.time)
        && request.resource.data.expiresAt <= request.time + duration.value(31, "d");
    }

    match /schedules/{userId} {
      allow read, delete: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create, update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId);
    }

    match /users/{userId} {
      allow read, delete: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create, update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId);
    }

    match /users/{userId}/schedules/{scheduleId} {
      allow read, delete: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validScheduleDocument(request.resource.data);
      allow update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validScheduleDocument(request.resource.data)
        && isMonotonicVersionUpdate();
    }

    match /users/{userId}/global/{documentId} {
      allow read, delete: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validGlobalDocument(request.resource.data);
      allow update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validGlobalDocument(request.resource.data)
        && (
          isMonotonicVersionUpdate()
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["watermark", "watermarkUpdatedAt"])
        );
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && isInstallationId(deviceId)
        && validDeviceDocument(request.resource.data)
        && request.resource.data.status == "active";
      allow update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && isInstallationId(deviceId)
        && validDeviceDocument(request.resource.data)
        && (
          (
            resource.data.status == "active"
            && request.resource.data.status == "active"
            && request.resource.data.createdAt == resource.data.createdAt
          )
          || (
            resource.data.status == "active"
            && request.resource.data.status in ["revoked", "expired"]
          )
          || (
            resource.data.status in ["revoked", "expired"]
            && request.resource.data.status == "active"
            && recentlyAuthenticated()
          )
        );
      allow delete: if canDeleteOwnAccountData(userId);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isOwnerAndVerified(userId)
        || canDeleteOwnAccountData(userId);
      allow create: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validNotificationDocument(request.resource.data)
        && request.resource.data.readAt == null
        && request.resource.data.createdAt >= request.time - duration.value(5, "m")
        && request.resource.data.createdAt <= request.time + duration.value(5, "m")
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(91, "d");
      allow update: if isOwnerAndVerified(userId)
        && !deletionRequested(userId)
        && validNotificationDocument(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && request.resource.data.readAt is timestamp
        && request.resource.data.readAt <= request.time + duration.value(5, "m");
    }

    match /deleted_accounts/{userId} {
      allow create: if isOwner(userId)
        && recentlyAuthenticated()
        && !deletionRequested(userId)
        && request.resource.data.keys().hasOnly(["requestedAt"])
        && request.resource.data.keys().hasAll(["requestedAt"])
        && request.resource.data.requestedAt == request.time;
      allow get: if isOwner(userId);
      allow list, update, delete: if false;
    }

    match /shared_schedules/{shareCode} {
      allow get: if isShareCode(shareCode)
        && (!sharedScheduleExists(shareCode)
          || isActivePublicShare(resource.data)
          || ownsShare(resource.data)
          || canDeleteOwnedShare(resource.data));

      allow list: if ownsShare(resource.data)
        || canDeleteOwnedShare(resource.data);

      allow create: if validSharedScheduleCreate(shareCode);

      allow update: if false;

      allow delete: if isShareCode(shareCode)
        && (ownsShare(resource.data) || canDeleteOwnedShare(resource.data));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
