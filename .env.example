# EXPO_PUBLIC_* values are embedded in the app and are not secrets.
# .env holds the production Firebase project (planit-hub). Development runs
# (`expo start`, dev-client builds) also load .env.development, which overrides
# every EXPO_PUBLIC_FIREBASE_* value and EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID with the
# planitflow-dev project, sets EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID= (empty), and
# points GOOGLE_SERVICES_FILE / GOOGLE_SERVICE_INFO_PLIST at
# ./google-services.dev.json and ./GoogleService-Info.dev.plist.
# See docs/FIREBASE_ENVIRONMENTS.md.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local builds use Google test ads. Release scripts force production ads.
EXPO_PUBLIC_FORCE_TEST_ADS=true
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=

# Web popup sign-in uses WEB_APP_URL's host as authDomain (src/config/website.cjs).
# Native Firebase auth links use the separate Firebase handler below.
EXPO_PUBLIC_FIREBASE_AUTH_LINK_DOMAIN=planit-hub.firebaseapp.com
# Share app links use WEB_APP_URL; publish assetlinks.json and apple-app-site-association there.

# Local Android signing; never commit real passwords or keystores.
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# Native Apple account deletion requires the deployed revocation function.
EXPO_PUBLIC_APPLE_TOKEN_REVOCATION_ENDPOINT=
