# EXPO_PUBLIC_* values are embedded in the app and are not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local builds use Google test ads. Release scripts force production ads.
EXPO_PUBLIC_FORCE_TEST_ADS=true
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=

# Web popup sign-in uses the app origin as authDomain (app.planitflow.com).
# Native auth links keep planit-hub.firebaseapp.com; web shares use https://app.planitflow.com.
EXPO_PUBLIC_FIREBASE_AUTH_LINK_DOMAIN=planit-hub.firebaseapp.com
# Publish assetlinks.json and apple-app-site-association on this host for native app links.
EXPO_PUBLIC_SHARE_LINK_DOMAIN=planit-demo.web.app

# Local Android signing; never commit real passwords or keystores.
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# Native Apple account deletion requires the deployed revocation function.
EXPO_PUBLIC_APPLE_TOKEN_REVOCATION_ENDPOINT=
