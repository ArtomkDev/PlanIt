{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm run config:sync", "npm --prefix functions run check"]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8180 },
    "storage": { "host": "127.0.0.1", "port": 9299 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "hosting": {
    "target": "app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/_expo/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ],
    "rewrites": [
      {
        "regex": "^/(auth|password-reset|legal/[A-Za-z-]+|share/[A-Za-z0-9]{5,32}|tasks|welcome|settings(/[A-Za-z0-9_-]+)*|MainLayout(/[A-Za-z0-9_-]+)*)/?$",
        "destination": "/index.html"
      }
    ]
  }
}
